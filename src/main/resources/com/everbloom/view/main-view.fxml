<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.everbloom.controller.MainController"
            stylesheets="@../css/app.css"
            styleClass="app-shell">
    <left>
        <VBox prefWidth="248.0" styleClass="sidebar">
            <children>
                <VBox spacing="5.0" styleClass="brand-block">
                    <children>
                        <Label text="EverBloom" styleClass="brand-name" />
                        <Label text="FLOWER SHOP MANAGER" styleClass="brand-subtitle" />
                    </children>
                </VBox>

                <Label text="WORKSPACE" styleClass="navigation-heading" />

                <VBox spacing="7.0" styleClass="navigation-list">
                    <children>
                        <Button fx:id="dashboardButton" text="Dashboard" maxWidth="Infinity"
                                onAction="#showDashboard" styleClass="nav-button" />
                        <Button fx:id="bouquetBuilderButton" text="Bouquet Builder" maxWidth="Infinity"
                                onAction="#showBouquetBuilder" styleClass="nav-button" />
                        <Button fx:id="ordersButton" text="Orders" maxWidth="Infinity"
                                onAction="#showOrders" styleClass="nav-button" />
                        <Button fx:id="catalogueButton" text="Catalogue" maxWidth="Infinity"
                                onAction="#showCatalogue" styleClass="nav-button" />
                        <Button fx:id="customersButton" text="Customers" maxWidth="Infinity"
                                onAction="#showCustomers" styleClass="nav-button" />
                        <Button fx:id="reportsButton" text="Reports" maxWidth="Infinity"
                                onAction="#showReports" styleClass="nav-button" />
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="4.0" styleClass="sidebar-footer">
                    <children>
                        <Label text="Boutique workspace" styleClass="sidebar-footer-title" />
                        <Label text="Thoughtfully arranged" styleClass="sidebar-footer-copy" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>
</BorderPane>
