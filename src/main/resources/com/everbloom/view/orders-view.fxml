<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22.0" styleClass="catalogue-page"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.everbloom.controller.OrdersController">
    <children>
        <VBox spacing="5.0">
            <children>
                <Label text="Orders" styleClass="page-title" />
                <Label text="Search placed orders and move them through the fulfilment lifecycle." styleClass="page-subtitle" />
            </children>
        </VBox>

        <Label fx:id="messageLabel" managed="false" text="" visible="false" styleClass="catalogue-message" />

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <TextField fx:id="searchField" promptText="Search order or customer"
                           onKeyReleased="#refreshOrders" styleClass="catalogue-search" />
                <ComboBox fx:id="statusComboBox" onAction="#refreshOrders" prefWidth="170.0" />
                <ComboBox fx:id="fulfillmentComboBox" onAction="#refreshOrders" prefWidth="170.0" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Refresh" onAction="#refreshOrders" styleClass="secondary-action" />
            </children>
        </HBox>

        <HBox alignment="TOP_LEFT" spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="16.0" HBox.hgrow="ALWAYS" styleClass="customer-list-card">
                    <children>
                        <TableView fx:id="orderTable" VBox.vgrow="ALWAYS" styleClass="catalogue-table">
                            <columns>
                                <TableColumn fx:id="numberColumn" text="ORDER" prefWidth="170.0" />
                                <TableColumn fx:id="customerColumn" text="CUSTOMER" prefWidth="200.0" />
                                <TableColumn fx:id="statusColumn" text="STATUS" prefWidth="150.0" />
                                <TableColumn fx:id="totalColumn" text="TOTAL" prefWidth="140.0" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Advance Status" onAction="#advanceOrder" styleClass="primary-action" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox prefWidth="330.0" spacing="14.0" styleClass="customer-details-card">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Order Details" styleClass="section-title" />
                                <Label text="Contents, pricing, and fulfilment of the selected order." styleClass="section-subtitle" wrapText="true" />
                            </children>
                        </VBox>
                        <TextArea fx:id="detailsArea" editable="false" focusTraversable="false" wrapText="true"
                                  VBox.vgrow="ALWAYS" styleClass="bouquet-summary-area" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
