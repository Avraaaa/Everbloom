<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.everbloom.controller.ReportsController" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="20.0" styleClass="reports-page">
            <children>
                <VBox spacing="5.0"><children><Label text="Reports" styleClass="page-title" /><Label text="Review sales and the most requested bouquet items." styleClass="page-subtitle" /></children></VBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="reports-filter-card"><children><Label text="From" styleClass="customer-details-label" /><DatePicker fx:id="startDatePicker" /><Label text="To" styleClass="customer-details-label" /><DatePicker fx:id="endDatePicker" /><Button text="Run Reports" onAction="#runReports" styleClass="primary-action" /></children></HBox>
                <Label fx:id="messageLabel" managed="false" visible="false" styleClass="reports-message" />
                <VBox spacing="12.0" styleClass="reports-card"><children><VBox spacing="4.0"><children><Label text="Sales by Date" styleClass="section-title" /><Label text="Order count and revenue across the selected period." styleClass="section-subtitle" /></children></VBox><TableView fx:id="salesTable" prefHeight="210.0" styleClass="catalogue-table"><columns><TableColumn fx:id="salesDateColumn" text="DATE" prefWidth="210.0" /><TableColumn fx:id="salesOrderCountColumn" text="ORDERS" prefWidth="170.0" /><TableColumn fx:id="salesRevenueColumn" text="REVENUE" prefWidth="220.0" /></columns></TableView></children></VBox>
                <HBox alignment="TOP_LEFT" spacing="20.0"><children>
                    <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="reports-card"><children><VBox spacing="4.0"><children><Label text="Popular Flowers" styleClass="section-title" /><Label text="Flowers sold in the selected period." styleClass="section-subtitle" /></children></VBox><TableView fx:id="flowerTable" prefHeight="230.0" styleClass="catalogue-table"><columns><TableColumn fx:id="flowerNameColumn" text="FLOWER" prefWidth="190.0" /><TableColumn fx:id="flowerQuantityColumn" text="QUANTITY" prefWidth="120.0" /><TableColumn fx:id="flowerRevenueColumn" text="REVENUE" prefWidth="150.0" /></columns></TableView></children></VBox>
                    <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="reports-card"><children><VBox spacing="4.0"><children><Label text="Popular Extras" styleClass="section-title" /><Label text="Extras sold in the selected period." styleClass="section-subtitle" /></children></VBox><TableView fx:id="extraTable" prefHeight="230.0" styleClass="catalogue-table"><columns><TableColumn fx:id="extraNameColumn" text="EXTRA" prefWidth="190.0" /><TableColumn fx:id="extraQuantityColumn" text="QUANTITY" prefWidth="120.0" /><TableColumn fx:id="extraRevenueColumn" text="REVENUE" prefWidth="150.0" /></columns></TableView></children></VBox>
                </children></HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
